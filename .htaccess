# Tadas Cikanavičius — tadascikanavicius.com
# Clean URLs for the CV and portfolio pages (EN + LT), HTTPS enforcement,
# and a root -> /cv redirect.

RewriteEngine On

# --- 1. Force HTTPS ---
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- 2. Redirect bare domain to /cv ---
RewriteRule ^$ /cv [R=301,L]

# --- 3. Redirect raw .html filenames to their clean URL (one canonical URL per page) ---
RewriteCond %{THE_REQUEST} \s/+index-lt\.html[\s?] [NC]
RewriteRule ^ /cv/lt [R=301,L]

RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ /cv [R=301,L]

RewriteCond %{THE_REQUEST} \s/+portfolio-lt\.html[\s?] [NC]
RewriteRule ^ /portfolio/lt [R=301,L]

RewriteCond %{THE_REQUEST} \s/+portfolio\.html[\s?] [NC]
RewriteRule ^ /portfolio [R=301,L]

# --- 4. Clean URLs (internal rewrites — address bar stays clean) ---
RewriteRule ^cv/lt/?$ index-lt.html [L]
RewriteRule ^cv/?$ index.html [L]
RewriteRule ^portfolio/lt/?$ portfolio-lt.html [L]
RewriteRule ^portfolio/?$ portfolio.html [L]
